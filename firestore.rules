rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isShortString(value, maxLen) {
      return value is string && value.size() <= maxLen;
    }

    function isEmail(value) {
      return value is string && value.size() <= 254 && value.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    // Téléphone au format international : + puis 6 à 15 chiffres (tous les pays)
    function isPhone(value) {
      return value is string && value.matches('^\\+[0-9]{6,15}$');
    }

    function profileOk(d) {
      return isShortString(d.firstName, 100) && d.firstName.size() > 0 &&
             isShortString(d.lastName, 100) && d.lastName.size() > 0 &&
             (!('phone' in d) || d.phone == '' || isPhone(d.phone)) &&
             (!('address' in d) || isShortString(d.address, 300)) &&
             (!('updatedAt' in d) || d.updatedAt is string);
    }

    // ---------- Commandes : validation des articles ----------
    // Les règles n'ont pas de boucle : on vérifie jusqu'à 10 articles (limite de lectures par requête).
    // Chaque article doit avoir le prix réel du produit en base et un stock suffisant.

    function itemOk(items, i) {
      return i >= items.size() || (
        items[i].keys().hasOnly(['productId', 'name', 'price', 'quantity']) &&
        items[i].productId is string &&
        isShortString(items[i].name, 200) &&
        items[i].quantity is int &&
        items[i].quantity > 0 &&
        items[i].quantity <= 100 &&
        items[i].price == get(/databases/$(database)/documents/products/$(items[i].productId)).data.price &&
        items[i].quantity <= get(/databases/$(database)/documents/products/$(items[i].productId)).data.stock
      );
    }

    function lineTotal(items, i) {
      return i < items.size() ? items[i].price * items[i].quantity : 0;
    }

    function itemsOk(items) {
      return items is list && items.size() > 0 && items.size() <= 10 &&
             itemOk(items, 0) && itemOk(items, 1) && itemOk(items, 2) && itemOk(items, 3) &&
             itemOk(items, 4) && itemOk(items, 5) && itemOk(items, 6) && itemOk(items, 7) &&
             itemOk(items, 8) && itemOk(items, 9);
    }

    function totalOk(items, total) {
      return total == lineTotal(items, 0) + lineTotal(items, 1) + lineTotal(items, 2) +
                      lineTotal(items, 3) + lineTotal(items, 4) + lineTotal(items, 5) +
                      lineTotal(items, 6) + lineTotal(items, 7) + lineTotal(items, 8) +
                      lineTotal(items, 9);
    }

    function customerOk(c) {
      return c is map &&
             c.keys().hasOnly(['firstName', 'lastName', 'phone', 'address', 'email']) &&
             isShortString(c.firstName, 100) && c.firstName.size() > 0 &&
             isShortString(c.lastName, 100) && c.lastName.size() > 0 &&
             c.phone is string && c.phone.matches('^\\+?[0-9 ]{7,20}$') &&
             (!('address' in c) || isShortString(c.address, 300)) &&
             (!('email' in c) || c.email == '' || isEmail(c.email));
    }

    function orderOk(data) {
      return data.keys().hasOnly(['userId', 'customer', 'items', 'total', 'status', 'date']) &&
             data.status == 'pending' &&
             data.date is string &&
             customerOk(data.customer) &&
             itemsOk(data.items) &&
             totalOk(data.items, data.total);
    }

    // ---------- Collections ----------

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Inscription : le document porte l'uid de l'utilisateur et le rôle 'user' (pas d'auto-promotion)
      allow create: if isOwner(userId) &&
                       request.resource.data.role == 'user' &&
                       request.resource.data.keys().hasOnly(['email', 'firstName', 'lastName', 'role', 'createdAt', 'authProvider']);

      // Profil : l'utilisateur ne modifie que ses informations personnelles (jamais son rôle ni son email)
      allow update: if (isOwner(userId) &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['firstName', 'lastName', 'phone', 'address', 'updatedAt']) &&
                        profileOk(request.resource.data)) ||
                       isAdmin();

      // Suppression du compte par son propriétaire (ou par l'admin)
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /favorites/{favoriteId} {
      allow read: if isAuthenticated() &&
                     (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.productId is string &&
                       request.resource.data.keys().hasOnly(['userId', 'productId', 'createdAt']);

      allow delete: if isAuthenticated() &&
                       (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /reservations/{reservationId} {
      allow read: if isAuthenticated() &&
                     (resource.data.userId == request.auth.uid ||
                      resource.data.guestEmail == request.auth.token.email ||
                      isAdmin());

      // Utilisateur connecté : la réservation porte son uid
      // Invité : uniquement un email valide, pas d'uid
      allow create: if request.resource.data.productId is string &&
                       request.resource.data.notificationMethod in ['email', 'whatsapp'] &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.createdAt is string &&
                       (
                         (isAuthenticated() &&
                          request.resource.data.userId == request.auth.uid &&
                          request.resource.data.keys().hasOnly(['productId', 'userId', 'notificationMethod', 'createdAt', 'status']))
                         ||
                         (isEmail(request.resource.data.guestEmail) &&
                          request.resource.data.keys().hasOnly(['productId', 'guestEmail', 'notificationMethod', 'createdAt', 'status']))
                       );

      allow delete: if isAuthenticated() &&
                       (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /orders/{orderId} {
      allow read: if isAuthenticated() &&
                     (resource.data.userId == request.auth.uid || isAdmin());

      // Client connecté : userId = son uid. Invité : userId = 'guest'.
      // Prix, total et stock sont vérifiés contre la base (impossible de payer moins cher).
      allow create: if orderOk(request.resource.data) &&
                       ((isAuthenticated() && request.resource.data.userId == request.auth.uid) ||
                        (!isAuthenticated() && request.resource.data.userId == 'guest'));

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() &&
                     (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow update: if isAuthenticated() &&
                       (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() &&
                       (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Collection mail - utilisée par l'extension Firebase "Trigger Email"
    match /mail/{mailId} {
      // Admin : tout envoi (notifications de stock).
      // Client : uniquement un email vers sa propre adresse (email de bienvenue), pour empêcher le spam.
      allow create: if isAdmin() ||
                       (isAuthenticated() &&
                        request.resource.data.to is list &&
                        request.resource.data.to.size() == 1 &&
                        request.resource.data.to[0] == request.auth.token.email);

      allow read, update, delete: if isAdmin();
    }
  }
}
