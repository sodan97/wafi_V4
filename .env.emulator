# Mode essai local (npm run dev:emulator) : le site parle aux émulateurs Firebase,
# jamais au vrai projet. Un projet « demo-… » ne peut pas atteindre les serveurs Google.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-wafi.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-wafi
VITE_FIREBASE_STORAGE_BUCKET=demo-wafi.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
